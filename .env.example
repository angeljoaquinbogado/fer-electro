# FER⚡ELECTRO — ejemplo de variables para Vercel
# Nunca subas valores reales de claves privadas al repositorio.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=

# URL pública estable de la tienda
PUBLIC_SITE_URL=https://fer-electro.vercel.app

# Email automático por Gmail
GMAIL_USER=ferelectroposadas@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_REPLY_TO=ferelectroposadas@gmail.com

# Seguridad adicional
# Opcional: secreto independiente para HMAC de rate limits.
# Si queda vacío, el servidor usa SUPABASE_SERVICE_ROLE_KEY como secreto interno.
RATE_LIMIT_SECRET=

# Firma de Webhooks de Mercado Pago.
# Cargar el secreto que Mercado Pago entrega para la URL del webhook.
MERCADOPAGO_WEBHOOK_SECRET=
# Dejar false durante TEST hasta confirmar que la firma funciona.
# En Producción, cambiar a true.
MERCADOPAGO_REQUIRE_SIGNATURE=false
